REMOTE_ORIGIN = "git@github.com:worldsense/trash.git"
LOCAL_ORIGIN = "file:///home/runner/work/trash/trash"
ORIGIN_REF = "main"
DEST_REF = "main"
AUTHOR = "Default Author <default@example.com>"

# For single-directory workflows, preserve original message if it looks scoped
# to that directory (e.g., "feat(sayt): ..." or "fix(sayt): ..."), otherwise
# use a generic sync message.
def scoped_message_transform(scope):
    """Returns a transform that keeps scoped messages or replaces with sync message."""
    def _transform(ctx):
        msg = ctx.message
        # Keep if message mentions the scope anywhere
        if scope in msg.lower():
            return
        # Replace with generic sync message, preserving first line as context
        first_line = msg.split("\n")[0][:72]
        ctx.set_message("Sync: " + first_line + "\n\nFrom worldsense/trash")
    return core.dynamic_transform(_transform, params = {"scope": scope})

# Source keeps sibling refs relative so a local checkout resolves them locally;
# the mirror needs them absolute and self-pinned. ITERATIVE replay reads VERSION
# per commit, so each synced commit pins the release it represents.
SAYT_COMPOSITES = ["ci", "depot", "install", "integrate", "summary"]
REFERENCE_APP_RUNTIME = [
    ".mise.toml",
    "bootstrap",
    "bootstrap.ps1",
    "cue.mod/**",
    "libraries/mecha/**",
    "plugins/bayt/**",
    "plugins/omnishell/**",
    "plugins/pronto/**",
    "plugins/sayt/**",
]

def _sayt_pin_siblings(ctx):
    version_path = ctx.new_path("VERSION")
    if not version_path.exists():
        return
    version = ctx.read_path(version_path).strip()
    for composite in SAYT_COMPOSITES:
        ctx.run(core.transform(
            [core.replace(
                before = "./.github/actions/sayt/" + composite,
                after = "bonisoft3/sayt/.github/actions/sayt/" + composite + "@" + version,
                paths = glob([".github/actions/sayt/*/action.yml"]),
            )],
            noop_behavior = "IGNORE_NOOP",
        ))

# A reference app travels with its runtime, its README at the root, and its
# release workflow at the root .github/, the one place GitHub reads one from:
# inert in the monorepo, active in the mirror.
def reference_app(name):
    return struct(
        name = name,
        destination = "git@github.com:bonisoft3/" + name + ".git",
        origin_files = REFERENCE_APP_RUNTIME + ["apps/" + name + "/**"],
        origin_excludes = [],
        transformations = [
            core.copy("apps/" + name + "/README.md", "", paths = glob(["README.md"])),
            core.transform(
                [core.move("apps/" + name + "/.github", ".github")],
                noop_behavior = "IGNORE_NOOP",
            ),
        ],
        submodules = "",
        mode = "SQUASH",
        scope = "",
    )

