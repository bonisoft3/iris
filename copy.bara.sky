        submodules = "",
        mode = "ITERATIVE",
        scope = "shall",
    ),
    struct(
        name = "bayt",
        destination = "git@github.com:bonisoft3/bayt.git",
        origin_files = [
            "plugins/bayt/**",
        ],
        origin_excludes = [],
        transformations = [
            # IGNORE_NOOP so the first run's --init-history walk
            # silently skips revs that pre-date plugins/bayt/.
            core.transform(
                [core.move("plugins/bayt", "")],
                noop_behavior = "IGNORE_NOOP",
            ),
            core.transform(
                [core.replace(
                    before = "./plugins/bayt",
                    after = ".",
                    paths = glob([".github/**"]),
                )],
                noop_behavior = "IGNORE_NOOP",
            ),
            # Tag mechanics are monorepo-only: prefixed tags, and the sync
            # wait. Guarded by developing_scrub_test.nu.
            core.transform(
                [core.replace(
                    before = "Tags are prefixed per component: `plugins/bayt/vX.Y.Z`,\n`plugins/bayt/runtime/vX.Y.Z`. Tag the merge commit; nothing has to be synced\nfirst, because `propagate-tag` publishes the component to its mirror before\nlooking the commit up there. Copybara replays a bounded batch per run, so a\nmirror far behind may not reach the tagged commit in one — the lookup is what\nreports it, and `sync.yml` run again closes the gap.",
                    after = "Tags are `vX.Y.Z` and `runtime/vX.Y.Z`. Tag the merge commit.",
                    paths = glob(["CONTRIBUTING.md"]),
                )],
                noop_behavior = "IGNORE_NOOP",
            ),
            # Stage cue.mod from .mirror/ → root. The monorepo
            # cannot host a nested cue.mod under plugins/bayt
            # without breaking in-monorepo CUE imports.
            core.transform(
                [core.move(".mirror/cue.mod", "cue.mod")],
                noop_behavior = "IGNORE_NOOP",
            ),
            # Rewrite bayt's CUE import identity so the mirror is
            # self-contained. In-monorepo: bonisoft.org/plugins/bayt/*.
            # On mirror: github.com/bonisoft3/bayt/* — matches the
            # mirror's cue.mod module path and lets external
            # consumers `cue mod tidy` against the Central Registry
            # publish with no CUE_REGISTRY config. Covers .nuon because
            # core/render_import.nuon feeds generate.nu the render.cue
            # import, and .md for README/DESIGN import examples.
            core.transform(
                [core.replace(
                    before = "bonisoft.org/plugins/bayt",
                    after = "github.com/bonisoft3/bayt",
                    paths = glob(["**.cue", "**.nuon", "**.md"]),
                )],
                noop_behavior = "IGNORE_NOOP",
            ),
        ],
        submodules = "",
        mode = "ITERATIVE",
        scope = "bayt",
    ),
    struct(
        name = "mecha",
        destination = "git@github.com:bonisoft3/mecha.git",
        origin_files = [
            "libraries/mecha/**",
        ],
        origin_excludes = [],
        transformations = [
            core.transform(
                [core.move("libraries/mecha", "")],
