# For single-directory workflows, preserve original message if it looks scoped
# to that directory (e.g., "feat(sayt): ..." or "fix(sayt): ..."), otherwise
# use a generic sync message.
def scoped_message_transform(scope):
    """Returns a transform that keeps scoped messages or replaces with sync message."""
    def _transform(ctx):
        msg = ctx.message
        # Keep if message mentions the scope anywhere
        if scope in msg.lower():
            return
        # Replace with generic sync message, preserving first line as context
        first_line = msg.split("\n")[0][:72]
        ctx.set_message("Sync: " + first_line + "\n\nFrom worldsense/trash")
    return core.dynamic_transform(_transform, params = {"scope": scope})

# Source keeps sibling refs relative so a local checkout resolves them locally;
# the mirror needs them absolute and self-pinned. ITERATIVE replay reads VERSION
# per commit, so each synced commit pins the release it represents.
SAYT_COMPOSITES = ["ci", "depot", "install", "integrate", "summary"]
REFERENCE_APP_RUNTIME = [
    ".mise.toml",
    "mise.lock",
    # The workspace root's pronto-sources target, which monorepo/service.yaml
    # builds from the trees above; its generator, the root bayt.cue, stays.
    ".bayt/Dockerfile.pronto-sources",
    ".bayt/Taskfile.bayt.yml",
    ".bayt/Taskfile.yml",
    ".bayt/bayt.pronto-sources.json",
    ".bayt/compose.pronto-sources.yaml",
    "bootstrap",
    "bootstrap.ps1",
    "cue.mod/**",
    "libraries/mecha/**",
    "plugins/bayt/**",
    "plugins/omnishell/**",
    "plugins/pronto/**",
    "plugins/sayt/**",
]

def _sayt_pin_siblings(ctx):
    version_path = ctx.new_path("VERSION")
    if not version_path.exists():
        return
    version = ctx.read_path(version_path).strip()
    for composite in SAYT_COMPOSITES:
        ctx.run(core.transform(
            [core.replace(
                before = "./.github/actions/sayt/" + composite,
                after = "bonisoft3/sayt/.github/actions/sayt/" + composite + "@" + version,
                paths = glob([".github/actions/sayt/*/action.yml"]),
            )],
            noop_behavior = "IGNORE_NOOP",
        ))

# pronto's markdown names its siblings by monorepo-relative paths, which lead
# nowhere in its mirror. .mirror/siblings.json maps each sibling's path from
# pronto to its mirror, the staged cue.mod's deps pin the release pronto builds
# against, and every link or wikilink resolving into a sibling becomes that
# file at that tag. plugins/pronto/links_test.ts refuses a link leaving pronto
# for anywhere this does not reach.
def _norm(parts):
    out = []
    for part in parts:
        if part == "" or part == ".":
            continue
        if part == ".." and out and out[-1] != "..":
            out.pop()
        else:
            out.append(part)
    return "/".join(out)

def _pin(module, name):
    at = module.find('"github.com/bonisoft3/' + name + '@v0"')
    if at < 0:
        fail("cue.mod/module.cue pins no release of " + name)
    start = module.find('"', module.find("v:", at)) + 1
    return module[start:module.find('"', start)]

def _slug(heading):
    out = ""
    for c in heading.lower().elems():
        if c.isalnum() or c == "-" or c == "_":
            out += c
        elif c == " ":
            out += "-"
    return out

# The path from the directory holding `src` to `path`, both from the root.
def _relative(src, path):
    here = src.split("/")[:-1]
    there = path.split("/")
    common = 0
    for i in range(min(len(here), len(there))):
        if here[i] != there[i]:
            break
        common = i + 1
    return "/".join([".."] * (len(here) - common) + there[common:])

# The sibling URL for `target` written in the file at `src`, or None. A path
# the mirror carries inside itself (.mirror/carried.json) becomes a relative
# link to where copybara moved it.
def _sibling_url(src, target, siblings, pins, carried = {}):
    if "://" in target or target.startswith("/") or target.startswith("mailto:"):
        return None
    resolved = _norm(src.split("/")[:-1] + target.split("/"))
    for at, to in carried.items():
        if resolved == at or resolved.startswith(at + "/"):
            return _relative(src, to + resolved[len(at):])
    for at, name in siblings.items():
        if resolved == at:
            return "https://github.com/bonisoft3/" + name + "/tree/" + pins[name]
        if resolved.startswith(at + "/"):
            return "https://github.com/bonisoft3/" + name + "/blob/" + pins[name] + resolved[len(at):]
    return None

def _link_wikilinks(text, src, siblings, pins, carried):
    out = ""
    rest = text
    for _ in range(len(text)):
        i = rest.find("[[")
        e = rest.find("]]", i + 2)
        if i < 0 or e < 0:
            break
        inner = rest[i + 2:e]
        bar = inner.find("|")
        target = inner if bar < 0 else inner[:bar].rstrip("\\")
        label = None if bar < 0 else inner[bar + 1:]
        sharp = target.find("#")
        path = target if sharp < 0 else target[:sharp]
        if "." not in path.split("/")[-1]:
            path += ".md"
        url = _sibling_url(src, path, siblings, pins, carried)
        if url == None:
            out += rest[:e + 2]
        else:
            if sharp >= 0:
                url += "#" + _slug(target[sharp + 1:])
            out += rest[:i] + "[" + (label or target.replace("../", "")) + "](" + url + ")"
        rest = rest[e + 2:]
    return out + rest

def _link_markdown(text, src, siblings, pins, carried):
    out = ""
    rest = text
    for _ in range(len(text)):
        i = rest.find("](")
        if i < 0:
            break
        start = i + 2
        end = len(rest)
        for stop in [")", " ", "\n"]:
            at = rest.find(stop, start)
            if at >= 0 and at < end:
                end = at
        target = rest[start:end]
        sharp = target.find("#")
        url = _sibling_url(src, target if sharp < 0 else target[:sharp], siblings, pins, carried)
        out += rest[:start] + (target if url == None else url + ("" if sharp < 0 else target[sharp:]))
        rest = rest[end:]
    return out + rest

def _pronto_link_siblings(ctx):
    map_path = ctx.new_path(".mirror/siblings.json")
    # Commits from before the map are replayed only by --init-history.
    if not map_path.exists():
        return
    siblings = json.decode(ctx.read_path(map_path))
    carried_path = ctx.new_path(".mirror/carried.json")
    carried = json.decode(ctx.read_path(carried_path)) if carried_path.exists() else {}
    module = ctx.read_path(ctx.new_path("cue.mod/module.cue"))
    pins = {name: _pin(module, name) for name in siblings.values()}
    for f in ctx.run(glob(["**.md"])):
        text = ctx.read_path(f)
        linked = _link_markdown(_link_wikilinks(text, f.path, siblings, pins, carried), f.path, siblings, pins, carried)
        if linked != text:
            ctx.write_path(f, linked)

# A reference app travels with its runtime, its README at the root, and its
# release workflow at the root .github/, the one place GitHub reads one from:
# inert in the monorepo, active in the mirror.
def reference_app(name):
    return struct(
        name = name,
        destination = "git@github.com:bonisoft3/" + name + ".git",
        origin_files = REFERENCE_APP_RUNTIME + ["apps/" + name + "/**"],
        origin_excludes = [],
        transformations = [
            core.transform(
                [core.copy("apps/" + name, "", paths = glob(["README.md"]))],
                reversal = [core.remove(glob(["README.md"]))],
                noop_behavior = "IGNORE_NOOP",
            ),
            core.transform(
                [core.move("apps/" + name + "/.github", ".github")],
                noop_behavior = "IGNORE_NOOP",
            ),
            # The pages workflow releases from the app's root, which this
            # mirror keeps where the monorepo does.
            core.transform(
                [
                    _rewrite("working-directory: .${end}", "working-directory: apps/" + name + "${end}", [".github/workflows/cd.yml"], {"end": "\n|$"}),
                    _rewrite("path: ./dist/browser", "path: apps/" + name + "/dist/browser", [".github/workflows/cd.yml"]),
                ],
                noop_behavior = "IGNORE_NOOP",
            ),
        ],
        submodules = "",
        mode = "SQUASH",
        scope = "",
    )

def _rewrite(before, after, paths, regex_groups = {}, exclude = []):
    return core.replace(
        before = before,
        after = after,
        regex_groups = regex_groups,
        paths = glob(paths, exclude = exclude),
        multiline = True,
    )

# A pronto app built as its own repository: its files alone, at the root, with
# nothing of the runtime. It pins the runtime's releases itself, and sync.yml
# publishes it only once its pins resolve from those releases
# (.github/mirror_pins.sh), and with `gate` once it also builds and integrates
# with them (.github/mirror_gate.sh). The one file that says the monorepo keeps the
# runtime stays behind: mise.local.toml, which names its trees and turns on
# the switch that builds the runtime's images from them, the lock mise writes
# beside it, and monorepo/service.yaml, the compose the switch includes, which
# names those trees.
def installed_app(name):
    app = "apps/" + name
    return struct(
        name = name,
        destination = "git@github.com:bonisoft3/" + name + ".git",
        origin_files = [app + "/**"],
        origin_excludes = [app + "/mise.local.toml", app + "/mise.local.lock", app + "/monorepo/service.yaml"],
        transformations = [
            core.move(app, ""),
            # The mirror's module, staged as the runtime's mirrors stage theirs.
            core.move(".mirror/cue.mod", "cue.mod"),
            # The runtime's packages by their published modules, until CUE's
            # import resolution config lets the monorepo name them so.
            _rewrite(
                "bonisoft.org/${part}/${module}",
                "github.com/bonisoft3/${module}",
                ["**.cue"],
                {"part": "plugins|libraries", "module": "bayt|mecha|omnishell|pronto|sayt"},
            ),
            # The app's own packages, which the mirror's module now holds.
            core.transform(
                [_rewrite("bonisoft.org/" + app + "/", "github.com/bonisoft3/" + name + "/", ["**.cue"])],
                noop_behavior = "IGNORE_NOOP",
            ),
        ],
        submodules = "",
        mode = "SQUASH",
        scope = "",
    )

