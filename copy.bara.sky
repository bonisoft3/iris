                noop_behavior = "IGNORE_NOOP",
            ),
            core.transform(
                [core.replace(
                    before = "bonisoft.org/plugins/sayt",
                    after = "github.com/bonisoft3/sayt",
                    paths = glob(["**.cue"]),
                )],
                noop_behavior = "IGNORE_NOOP",
            ),
        ],
        submodules = "",
        mode = "ITERATIVE",
        scope = "sayt",
    ),
    struct(
        name = "shall",
        destination = "git@github.com:bonisoft3/shall.git",
        origin_files = [
            "plugins/shall/**",
        ],
        origin_excludes = [],
        transformations = [
            core.move("plugins/shall", ""),
