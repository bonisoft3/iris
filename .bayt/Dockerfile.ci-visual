COPY --from=iris-database_srcs --parents /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/000_extensions.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/001_roles.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/002_grants.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/004_types.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/006_policies.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/007_txid.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/008_publication.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/003_rls.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/005_create_tables.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/010_machines.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/013_me_provision.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/014_default_privileges.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/015_classify_request.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/016_translate_item.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/017_owner_writes.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/018_me_readonly.sql /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/migrations/020_demo_items.sql /
COPY --from=iris-migrate_srcs --parents /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/pgroll/20261114_ugc_translation.json /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/database/pgroll/20261122_machines.json /
COPY --from=iris-airlock_srcs --parents /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/airlock/effects.json /monorepo/${BAYT_DIR:+${BAYT_DIR}/}effects/classify-waste.js /
COPY --from=iris-airlock-mesh_srcs --parents /monorepo/${BAYT_DIR:+${BAYT_DIR}/}services/airlock/dapr/classify-waste.yaml /
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.ci-visual.yaml .bayt/bayt.ci-visual.json ./.bayt/
ENV BUILDX_BAKE_ENTITLEMENTS_FS=0
ENV COMPOSE_BAKE=true
RUN --mount=type=secret,id=docker_host --mount=type=secret,id=buildx_builder --mount=type=secret,id=testcontainers_host --mount=type=secret,id=cache_scope --mount=type=secret,id=cache_scope_fallback --mount=type=secret,id=sayt_buildkit_syntax --mount=type=secret,id=sayt_no_cache --mount=type=secret,id=bayt_image_tag --mount=type=secret,id=bayt_pull_policy --mount=type=secret,id=sayt_no_cache_from --mount=type=secret,id=sayt_no_cache_to --mount=type=secret,id=depot_token --mount=type=secret,id=depot_project_id --mount=type=secret,id=depot_org_id --mount=type=secret,id=depot_disable_otel --mount=type=secret,id=actions_results_url --mount=type=secret,id=actions_runtime_token --mount=type=secret,id=bkid_project --mount=type=secret,id=buildx_instance --mount=type=secret,id=docker_config,mode=0600 --mount=type=cache,target=/root/.cache/bayt,id=iris-ci-visual:/root/.cache/bayt,sharing=locked <<BAYT_INJECT
set -e
export DOCKER_HOST="$(cat /run/secrets/docker_host)"
export BUILDX_BUILDER="$(cat /run/secrets/buildx_builder)"
export TESTCONTAINERS_HOST_OVERRIDE="$(cat /run/secrets/testcontainers_host)"
export CACHE_SCOPE="$(cat /run/secrets/cache_scope)"
export CACHE_SCOPE_FALLBACK="$(cat /run/secrets/cache_scope_fallback)"
export BUILDKIT_SYNTAX="$(cat /run/secrets/sayt_buildkit_syntax)"
export SAYT_NO_CACHE="$(cat /run/secrets/sayt_no_cache)"
export BAYT_IMAGE_TAG="$(cat /run/secrets/bayt_image_tag)"
export BAYT_PULL_POLICY="$(cat /run/secrets/bayt_pull_policy)"
export SAYT_NO_CACHE_FROM="$(cat /run/secrets/sayt_no_cache_from)"
export SAYT_NO_CACHE_TO="$(cat /run/secrets/sayt_no_cache_to)"
export DEPOT_TOKEN="$(cat /run/secrets/depot_token)"
export DEPOT_PROJECT_ID="$(cat /run/secrets/depot_project_id)"
export DEPOT_ORG_ID="$(cat /run/secrets/depot_org_id)"
export DEPOT_DISABLE_OTEL="$(cat /run/secrets/depot_disable_otel)"
export ACTIONS_RESULTS_URL="$(cat /run/secrets/actions_results_url)"
export ACTIONS_RUNTIME_TOKEN="$(cat /run/secrets/actions_runtime_token)"
export BKID_PROJECT="$(cat /run/secrets/bkid_project)"
export BUILDX_INSTANCE="$(cat /run/secrets/buildx_instance)"
export DOCKER_AUTH_CONFIG="$(cat /run/secrets/docker_config)"
if [ -s "/run/secrets/docker_config" ]; then mkdir -p "$(dirname "/root/.docker/config.json")"; cp -p "/run/secrets/docker_config" "/root/.docker/config.json"; fi
if [ -n "$DOCKER_HOST" ] && [ ! -e /var/run/docker.sock ]; then
  ulimit -n 1048576 2>/dev/null || true
  addr=${DOCKER_HOST#tcp://}
  [ -n "$addr" ] || { echo "bkid: DOCKER_HOST=$DOCKER_HOST has no tcp:// address" >&2; exit 1; }
  socat -d0 -t 86400 UNIX-LISTEN:/var/run/docker.sock,fork,backlog=1024,reuseaddr "TCP:$addr,keepalive,keepidle=30,keepintvl=15,keepcnt=4" &
  SOCAT_PID=$!
  trap 'kill $SOCAT_PID 2>/dev/null || true' EXIT INT TERM
  socat -u OPEN:/dev/null UNIX-CONNECT:/var/run/docker.sock,retry=20,interval=0.2 >/dev/null 2>&1 \
    || { echo "bkid: socat bridge to /var/run/docker.sock not ready" >&2; exit 1; }
fi
if [ -n "$BUILDX_BUILDER" ] && [ -n "$BUILDX_INSTANCE" ]; then
  install -d -m 0700 /root/.docker/buildx/instances
  printf '%s' "$BUILDX_INSTANCE" > "/root/.docker/buildx/instances/$BUILDX_BUILDER"
  chmod 0600 "/root/.docker/buildx/instances/$BUILDX_BUILDER"
fi
task -t .bayt/Taskfile.yml bayt:ci-visual
BAYT_INJECT

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS ci-visual_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.ci-visual.yaml .bayt/Dockerfile.ci-visual .bayt/bayt.ci-visual.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.ci-visual.yaml .bayt/process-compose.yaml ./
COPY --from=iris-integrate_bayt /monorepo /monorepo
COPY --from=iris-caddy_bayt /monorepo /monorepo
COPY --from=iris-served_bayt /monorepo /monorepo
COPY --from=iris-served-release_bayt /monorepo /monorepo
COPY --from=iris-database_bayt /monorepo /monorepo
COPY --from=iris-migrate_bayt /monorepo /monorepo
COPY --from=iris-airlock_bayt /monorepo /monorepo
COPY --from=iris-airlock-mesh_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS ci-visual_bayt
COPY --from=ci-visual_bayt_ctxs /monorepo /monorepo
