{
  "hosting": [
    {
      "site": "trash-362115",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "iris-mecha",
            "region": "us-central1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "public, s-maxage=60, stale-while-revalidate=86400" }
          ]
        },
        {
          "source": "**/_next/static/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    }
  ]
}
