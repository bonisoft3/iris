{
  "endpoints": {
    "k8s": {
      "classify-waste": "http://tsbifrost:8090"
    }
  },
  "prunesTokenRoles": true,
  "rowMachines": {
    "ClassifyJobMachine": {
      "name": "ClassifyJobMachine",
      "ir": "ClassifyJobMachine",
      "entity": "ClassifyJob",
      "guards": {},
      "level": "external",
      "hatches": [],
      "field": "status",
      "initial": "classifying",
      "states": {
        "classifying": {
          "invoke": {
            "src": "classify-waste",
            "onDone": {
              "target": "done",
              "actions": [
                {
                  "assign": {
                    "result_json": {
                      "raw": "COALESCE(outcome->'data'->>'result_json', '')"
                    }
                  }
                }
              ]
            },
            "onError": {
              "target": "failed",
              "actions": [
                {
                  "assign": {
                    "result_json": {
                      "raw": "COALESCE(outcome->>'kind', 'failed')"
                    }
                  }
                }
              ]
            }
          }
        },
        "done": {
          "type": "final"
        },
        "failed": {
          "type": "final"
        }
      }
    }
  },
  "schema": {
    "pgroll": {
      "target": "migrate",
      "dir": "/pgroll",
      "baseline": "00_initdb"
    },
    "target": "database",
    "initdb": "/docker-entrypoint-initdb.d"
  },
  "database": "bonitao/mecha-database:0.34.0@sha256:1e65261fd9507f7c935a939c43916fb3a61f335cf50002478b31a8d643a103df",
  "server": true,
  "steps": {
    "graphile": "011_graphile_worker.sql",
    "airlock": "012_airlock.sql",
    "jobKey": "019_airlock_job_key.sql",
    "note": "The steps 013 to 018 write no classify_job row: 015's inserts are inside trigger functions, which the demo items at 020 are the first to fire."
  },
  "tokenRoles": [
    "anon",
    "app_user",
    "service"
  ],
  "computations": [],
  "drains": []
}
